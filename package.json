{
  "name": "concierge-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "concierge:ligar": "powershell -ExecutionPolicy Bypass -File ./ops/concierge-control.ps1 ligar",
    "concierge:desligar": "powershell -ExecutionPolicy Bypass -File ./ops/concierge-control.ps1 desligar",
    "concierge:status": "powershell -ExecutionPolicy Bypass -File ./ops/concierge-control.ps1 status",
    "webhook:set": "node ops/set-telegram-webhook.js",
    "webhook:info": "node ops/webhook-info.js",
    "tunnel:cf": "npx --yes cloudflared tunnel --url http://127.0.0.1:3000",
    "concierge:reset": "node ops/reset-sessions.js",
    "concierge:reset-full": "node ops/reset-sessions.js --full",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
