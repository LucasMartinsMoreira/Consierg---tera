    "@openai/agents": "^0.8.3",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "openai": "^6.27.0",
    "serpapi": "^2.2.1",
    "zod": "^4.3.6"
